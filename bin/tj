#!/usr/bin/env node

import "dotenv/config";
import fs from "fs/promises";
import path from "path";
import readline from "readline/promises";

import open from "open";
import { program } from "commander";
import { DateTime, Settings } from "luxon";
import { createMongoClient } from "../src/mongo-client.js";
import { TradeIdGenerator, OrderIdGenerator } from "../src/id-gen.js";
import { TradeService } from "../src/trade-service.js";
import { TradeFormatter } from "../src/trade-formatter.js";
import config from "../tj.config.js";


async function readStdin() {
    const chunks = [];

    for await (const chunk of process.stdin) {
        chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
    }

    return Buffer.concat(chunks).toString("utf-8");
}

async function withTradeService(handler) {
    const mongoClient = await createMongoClient(process.env.Mongo_url);
    await mongoClient.connect();
    const db = mongoClient.db("trading-journal");

    const tradeService = new TradeService(db);
    tradeService.tradeIdGenerator = new TradeIdGenerator(db);
    tradeService.orderIdGenerator = new OrderIdGenerator(db);
    tradeService.tradeFormatter = new TradeFormatter();

    try {
        return await handler(tradeService);
    } finally {
        await mongoClient.close();
    }
}

function parseTags(value) {
    if (!value) {
        return undefined;
    }

    const arr = value
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean);

    return arr.length ? arr : undefined;
}


async function draft(templateJson, options) {
    const dt = DateTime.now()
    const timeStr = dt.toFormat('yyyyMMdd-HHmmss');
    const filename = `draft-${timeStr}.json`;
    const filePath = path.join(config.dataDir, filename);

    const defaultTemplate = {
        accountId: "",
        symbol: "",
        direction: "long | short",
        orders: [
            {
                type: 'entry | add | reduce | close',
                price: null,
                amount: null,
                executedAt: dt.toFormat('yyyy-MM-dd HH:mm')
            }
        ],
        multiplier: 1,
        tags: []
    }

    let userTemplate = {};

    if (templateJson) {
        try {
            userTemplate = JSON.parse(templateJson);
        } catch (e) {
            throw new Error('Parse template string failed');
        }

        if (typeof userTemplate !== 'object') {
            throw new Error('Invalid template');
        }
    }

    const finalTemplate = { ...defaultTemplate, ...userTemplate };

    const content = JSON.stringify(finalTemplate, undefined, 4);
    await fs.writeFile(filePath, content);

    if (options.open) {
        await open(filePath, { wait: false });
    }
}

async function commit(files) {
    await withTradeService(async (tradeService) => {
        if (files.length === 0) {
            await commitTradeStdin(tradeService);
            return;
        }

        for (const file of files) {
            let filePath = file.endsWith('.json') ? file : `${file}.json`;
            if (!path.isAbsolute(filePath)) {
                filePath = path.join(config.dataDir, path.basename(filePath));
            }

            try {
                await commitTradeFile(tradeService, filePath);
            } catch (e) {
                console.error(`Commit ${path.basename(filePath)} error: ${e.message}`);
            }
        }
    });
}

async function commitTradeStdin(tradeService) {
    const content = await readStdin();

    if (!content.trim()) {
        throw new Error("No input from stdin");
    }

    const tradeData = JSON.parse(content);
    const orders = tradeData.orders;

    if (!Array.isArray(orders) || orders.length === 0) {
        throw new Error("orders must be a non-empty array");
    }

    const lastOrder = orders[orders.length - 1];

    if (tradeData.id) {
        throw new Error("stdin commit only accepts a complete new trade without id");
    }

    if (lastOrder.type !== "close") {
        throw new Error("stdin commit only accepts a complete trade whose last order is 'close'");
    }

    const tradeDetail = await tradeService.recordTrade(tradeData);

    console.log(`Record Trade: ${tradeDetail.id}`);
}

async function commitTradeFile(tradeService, filePath) {
    const fileName = path.basename(filePath);

    const content = await fs.readFile(filePath, "utf-8");
    const tradeData = JSON.parse(content);

    const orders = tradeData.orders;
    if (!Array.isArray(orders) || orders.length === 0) {
        throw new Error("orders must be a non-empty array");
    }

    const lastOrder = orders[orders.length - 1];

    const orderTemplate = {
        type: 'add | reduce | close',
        price: null,
        amount: null,
        executedAt: DateTime.now().toFormat('yyyy-MM-dd HH:mm')
    }

    let tradeId = tradeData.id;
    
    if (!tradeId) {
        if (lastOrder.type === 'close') {
            const tradeDetail = await tradeService.recordTrade(tradeData);
            await fs.unlink(filePath);
            console.log(`Record Trade: ${tradeId}. File [${fileName}] deleted.`);
        } else {
            tradeId = await tradeService.openTrade(tradeData);
            tradeData.id = tradeId;
            tradeData.orders = [orderTemplate];
            tradeData.tags = [];
            await fs.writeFile(filePath, JSON.stringify(tradeData, undefined, 4));
            console.log(`Open Trade: ${tradeId}. File [${fileName}] reset to template.`);
        }
    } else {
        if (lastOrder.type === 'close') {
            await tradeService.closeTrade(tradeId, tradeData);
            await fs.unlink(filePath);
            console.log(`Close Trade: ${tradeId}. File [${fileName}] deleted.`);
        } else {
            await tradeService.appendOrders(tradeId, orders);
            tradeData.orders = [orderTemplate];
            await fs.writeFile(filePath, JSON.stringify(tradeData, undefined, 4));
            console.log(`Append Orders: ${tradeId}. File [${fileName}] reset to template.`);
        }
    }
}

async function updateTags(tradeId, tags, options) {
    const tagsAfterUpdate = await withTradeService(async (tradeService) => {
        return await tradeService.updateTags(tradeId, tags, options.set ? false : true);
    });

    console.log(`Tags after update: ${JSON.stringify(tagsAfterUpdate)}`);
}

async function list(options) {
    const {
        id,
        account: accountId,
        symbol,
        tags,
        period,
        since,
        until,
        status,
        limit
    } = options;
    const timeRange = period ?? { since, until };
    const filter = { id, accountId, symbol, tags, status, timeRange, limit };
    const summary = await withTradeService(async (tradeService) => {
        return await tradeService.listTrades(filter);
    });
    console.log(JSON.stringify(summary, undefined, 2));
}

async function summarize(options) {
    const {
        account: accountId,
        symbol,
        tags,
        period,
        since,
        until
    } = options;
    const timeRange = period ?? { since, until };
    const filter = { accountId, symbol, tags, timeRange };
    const summary = await withTradeService(async (tradeService) => {
        return await tradeService.summarizeTrades(filter);
    })
    console.log(JSON.stringify(summary, undefined, 2));
}

async function showDetail(tradeId) {
    const tradeDetail = await withTradeService(async (tradeService) => {
        return await tradeService.showTradeDetail(tradeId);
    });
    console.log(JSON.stringify(tradeDetail, undefined, 4));
}

async function clear(options) {
    const rl = readline.createInterface({
        input: process.stdin,
        output: process.stdout
    });

    let answer;
    try {
        const message = 'This will permanently delete all trade records. continue? [y|n]: '
        answer = await rl.question(message);
    } finally {
        rl.close();
    }

    if (answer !== 'y') {
        console.log('Cancelled. No trades were deleted.');
        return;
    }

    const deletedCount = await withTradeService(async (tradeService) => {
        return await tradeService.clear();
    });
    console.log(`Deleted ${deletedCount} trade(s)`);
}

async function deleteTrades(options) {
    const {
        id,
        account: accountId,
        symbol,
        tags,
        period,
        since,
        until,
        status,
    } = options;
    const timeRange = period ?? { since, until };
    const filter = { id, accountId, symbol, tags, timeRange, status };
    const deletedCount = await withTradeService(async (tradeService) => {
        return await tradeService.deleteTrades(filter);
    });
    console.log(`Deleted ${deletedCount} trade(s)`);
}

async function main() {
    Settings.defaultZone = config.timezone;
    Settings.defaultLocale = config.locale;

    program
        .name("tj")
        .description("Trading Journal CLI")
        .version("0.1.0");

    program
        .command("draft")
        .description("Create a local trade draft file in data directory")
        .argument("[templateJson]", "JSON template string to merge with default template")
        .option("--no-open", "Do not open the file after creation")
        .action(draft);

    program
        .command("commit")
        .description("Commit trade JSON files or stdin")
        .argument("[files...]", "Trade files, or empty to read from stdin")
        .action(commit);

    program
        .command("tags")
        .description("Update tags of a closed trade")
        .argument("<tradeId>", "Trade ID")
        .argument("<tags...>", "Tags to set or merge")
        .option("--set", "Replace existing tags instead of merging")
        .action(updateTags);

    program
        .command("clear")
        .description("Reset the journal by clearing all trades and ID counters")
        .action(clear);

    program
        .command("delete")
        .description("Delete trades based on filters")
        .option("--id <tradeId>", "Specific trade ID to delete")
        .option("--account <accountId>", "Filter by account ID")
        .option("--symbol <symbol>", "Filter by symbol (e.g. BTCUSDT, AAPL)")
        .option("--tags <tags>", "Comma-separated tags, e.g. breakout,binance", parseTags)
        .option("--since <iso>", "Start date in ISO format")
        .option("--until <iso>", "End date in ISO format")
        .option("--period <iso>", "Filter by timeframe: day | week | month")
        .option("--status <status>", "Filter by status: active | closed")
        .action(deleteTrades);

    program
        .command("list")
        .description("List trades based on filters")
        .option("--id <tradeId>", "Specific trade ID to list")
        .option("--account <accountId>", "Filter by account ID")
        .option("--symbol <symbol>", "Filter by symbol (e.g. BTCUSDT, AAPL)")
        .option("--tags <tags>", "Comma-separated tags, e.g. breakout,binance", parseTags)
        .option("--since <iso>", "Start date in ISO format")
        .option("--until <iso>", "End date in ISO format")
        .option("--period <iso>", "Filter by timeframe: day | week | month")
        .option("--status <status>", "Filter by status: active | closed")
        .option("--limit <n>", "Result limit", parseFloat)
        .action(list);

    program
        .command("summarize")
        .description("Summarize trades based on filters")
        .option("--account <accountId>", "Filter by account ID")
        .option("--symbol <symbol>", "Filter by symbol (e.g. BTCUSDT, AAPL)")
        .option("--tags <tags>", "Comma-separated tags, e.g. breakout,binance", parseTags)
        .option("--since <iso>", "Start date in ISO format")
        .option("--until <iso>", "End date in ISO format")
        .option("--period <iso>", "Filter by timeframe: day | week | month")
        .action(summarize);

    program
        .command("show")
        .description("Show trade detail")
        .argument("<tradeId>", "ID of the trade to display")
        .action(showDetail);

    await program.parseAsync()
}

await main();
