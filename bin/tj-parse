#!/usr/bin/env node

import "dotenv/config";
import { program } from "commander";
import { DateTime } from "luxon";
import { createMongoClient } from "../src/mongo-client.js";
import { createLLMClient } from "../src/llm-client.js";
import { AccountService } from "../src/account-service.js";
import { TradeService } from "../src/trade-service.js";
import { parseTradeInput } from "../src/parse-trade-input.js";
import { readStdin } from "../src/helpers.js";
import config from "../tj.config.js";


async function parseUserInput(input) {
    let userInput = input ?? await readStdin();
    userInput = userInput?.trim();

    if (!userInput) {
        throw new Error("No input provided");
    }

    const mongo = await createMongoClient(config.mongoUrl);
    await mongo.connect();
    const db = mongo.db("trading-journal");
    const accountService = new AccountService(db);
    const tradeService = new TradeService(db);

    let accounts;
    let activeTrades;

    try {
        accounts = await accountService.list();
        accounts = accounts.map(({ id, type }) => ({ id, type }));
        activeTrades = await tradeService.listTrades({ status: "active" });
    } finally {
        await mongo.close();
    }

    const llm = await createLLMClient(config.llm);

    const now = DateTime.now().setZone(config.timezone);

    const record = await parseTradeInput({
        llm,
        currentTime: now.toFormat('yyyy-MM-dd HH:mm:ss'),
        timeZone: now.zoneName,
        accounts,
        activeTrades,
        userInput
    });
    
    console.log(JSON.stringify(record, null, 4));
}

async function main() {
    program
        .name("tj-parse")
        .description("Parse a natural language trade record and print JSON to stdout")
        .argument("[input]", "trade input text")
        .action(parseUserInput);

    program.parseAsync();
}

try {
    await main();
} catch (e) {
    console.error(e);
    process.exit(1);
}

