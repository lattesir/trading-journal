#!/usr/bin/env node

import "dotenv/config";
import fs from "fs/promises";
import { program } from "commander";
import { createMongoClient } from "../src/mongo-client.js";
import { AccountService } from "../src/account-service.js";
import * as schemas from "../src/schemas.js";


async function withAccountService(handler) {
    const client = await createMongoClient(process.env.Mongo_url);
    await client.connect();
    const db = client.db("trading-journal");
    const accountService = new AccountService(db);

    try {
        return await handler(accountService);
    } finally {
        await client.close();
    }
}

async function listAccounts(options) {
    const filter = {};

    if (options.id) {
        filter.id = options.id;
    }

    if (options.name) {
        filter.name = options.name;
    }

    if (options.type) {
        filter.type = options.type;
    }

    const accounts = await withAccountService(async (accountService) => {
        return await accountService.list(filter);
    });

    console.log(JSON.stringify(accounts, undefined, 4));
}

async function deleteAccount(accountId) {
    const deleted = await withAccountService(async (accountService) => {
        return await accountService.delete(accountId);
    });

    if (deleted) {
        console.log(`Account '${accountId}' deleted successfully.`);
    } else {
        console.log(`Account '${accountId}' not found.`);
    }
}

async function importAccounts(file) {
    const content = file ? await fs.readFile(file, "utf-8") : await readStdin();
    const trimmed = content.trim();
    
    if (!trimmed) {
        throw new Error('No input provided for import.');
    }

    const parsed = JSON.parse(trimmed);
    const accounts = Array.isArray(parsed) ? parsed : [ parsed ];

    await withAccountService(async (accountService) => {
        for (const account of accounts) {
            await accountService.save(account);
            console.log(`Imported account: ${account.id}`);
        }
    });
}

async function readStdin() {
    const chunks = [];

    for await (const chunk of process.stdin) {
        chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
    }

    return Buffer.concat(chunks).toString("utf-8");
}

async function readAccounts() {
    const content = await readStdin();

    if (!content.trim()) {
        throw new Error("No input from stdin");
    }

    const parsed = JSON.parse(content);
    const trades = Array.isArray(parsed) ? parsed : [ parsed ];
}

async function main() {
    program
        .name("tj-acct")
        .description("Manage trading journal accounts")
        .version("0.1.0");

    program
        .command("list")
        .description("List accounts")
        .option("--id <id>", "Filter by account id")
        .option("--name <name>", "Filter by account name")
        .option("--type <type>", "Filter by account type")
        .action(listAccounts);

    program
        .command("delete")
        .description("Delete an account by id")
        .argument("<accountId>", "Account ID")
        .action(deleteAccount);

    program
        .command("import")
        .description("Import accounts from JSON file or stdin")
        .argument("[file]", "Optional JSON file path, otherwise read from stdin")
        .action(importAccounts);

    await program.parseAsync()
}

await main();
